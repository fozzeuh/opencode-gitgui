{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-git-graph",
  "version": "0.1.0",
  "private": true,
  "description": "Native Git graph explorer for OpenCode Desktop (V2 GUI plugin)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.5"
  },
  "peerDependencies": {
    "effect": "^4.0.6",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.12.2",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "effect": "4.0.6",
    "eslint": "10.14.0",
    "solid-js": "1.9.18",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "7.3.7",
    "vite-plugin-solid": "2.11.15",
    "vitest": "4.1.12"
  }
}
